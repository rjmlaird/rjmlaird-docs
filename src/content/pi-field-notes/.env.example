# Copy to .env for local use. Both values are optional locally.
# In CI or on your host, set them as environment variables instead.

# The public address of the deployed site, with no trailing slash.
# Used for canonical URLs, the sitemap, the RSS feed and social cards.
SITE_URL=https://example.com

# The path the site is served from. Use "/" for a custom domain or a root
# deployment. For a GitHub Pages project site use "/repository-name/".
BASE_PATH=/
