---
// A decorative all-sky chart. It shows no real data: star positions come from a fixed seed,
// so the picture is identical on every build. Sky charts put east on the left when north is up.
let seed = 20261011;
const rand = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};
const stars = Array.from({ length: 90 }, () => {
  const angle = rand() * Math.PI * 2;
  const radius = Math.sqrt(rand()) * 186;
  return {
    x: +(200 + Math.cos(angle) * radius).toFixed(1),
    y: +(200 + Math.sin(angle) * radius).toFixed(1),
    r: +(0.6 + rand() * rand() * 2.2).toFixed(2),
  };
});
---

<svg class="all-sky" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
  <circle class="disc" cx="200" cy="200" r="190"></circle>
  <circle class="ring" cx="200" cy="200" r="127"></circle>
  <circle class="ring" cx="200" cy="200" r="63"></circle>
  <line class="ring" x1="200" y1="10" x2="200" y2="390"></line>
  <line class="ring" x1="10" y1="200" x2="390" y2="200"></line>
  {stars.map((s) => (
    <circle class="star" cx={s.x} cy={s.y} r={s.r}></circle>
  ))}
  <circle class="moon" cx="262" cy="118" r="7"></circle>
  <text x="200" y="26" text-anchor="middle">
    N
  </text>
  <text x="200" y="384" text-anchor="middle">
    S
  </text>
  <text x="24" y="205" text-anchor="middle">
    E
  </text>
  <text x="376" y="205" text-anchor="middle">
    W
  </text>
</svg>
