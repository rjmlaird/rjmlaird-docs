---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import TagList from '../../components/TagList.astro';
import { url } from '../../lib/site';
import {
  byDateDesc,
  formatDate,
  getPublished,
  isoDate,
  readingTime,
  STAGE_LABELS,
} from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getPublished('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const logs = (await getPublished('build-logs'))
  .filter((l) => l.data.project.id === entry.id)
  .sort(byDateDesc);
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
  published={d.dateStarted}
  modified={d.dateUpdated}
  image={d.heroImage?.src}
>
  <div class="container page">
    <a class="back-link" href={url('/projects/')}>
      Back to projects
    </a>
    <header class="article-header article">
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <div class="meta">
        <StatusBadge status={d.status} />
        <span>
          Started <time datetime={isoDate(d.dateStarted)}>{formatDate(d.dateStarted)}</time>
        </span>
        <span>
          Updated <time datetime={isoDate(d.dateUpdated)}>{formatDate(d.dateUpdated)}</time>
        </span>
        <span>{readingTime(entry.body)} min read</span>
        {d.draft && <span>Draft</span>}
      </div>
      <TagList tags={d.tags} />
    </header>

    {d.heroImage && (
      <figure class="hero-image">
        <Image
          src={d.heroImage}
          alt={d.heroImageAlt ?? ''}
          widths={[640, 960, 1280]}
          sizes="(min-width: 72rem) 72rem, 100vw"
        />
      </figure>
    )}

    {(d.hardware.length > 0 || d.software.length > 0 || d.githubUrl) && (
      <dl class="facts">
        {d.hardware.length > 0 && (
          <div>
            <dt>Hardware</dt>
            <dd>
              <ul>
                {d.hardware.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </dd>
          </div>
        )}
        {d.software.length > 0 && (
          <div>
            <dt>Software</dt>
            <dd>
              <ul>
                {d.software.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </dd>
          </div>
        )}
        {d.githubUrl && (
          <div>
            <dt>Source</dt>
            <dd>
              <a href={d.githubUrl}>Code and configuration on GitHub</a>
            </dd>
          </div>
        )}
      </dl>
    )}

    <div class="prose">
      <Content />
    </div>

    {logs.length > 0 && (
      <section class="block article" aria-labelledby="logs-title">
        <h2 id="logs-title">Build logs for this project</h2>
        <ul class="entry-list">
          {logs.map((l) => (
            <li class="entry">
              <div class="meta">
                <time datetime={isoDate(l.data.date)}>{formatDate(l.data.date)}</time>
                <span>{STAGE_LABELS[l.data.stage]}</span>
              </div>
              <h3>
                <a href={url(`/build-logs/${l.id}/`)}>{l.data.title}</a>
              </h3>
              <p>{l.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
