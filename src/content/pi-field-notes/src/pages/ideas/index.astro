---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryItem from '../../components/EntryItem.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { url } from '../../lib/site';
import { byDateDesc, formatDate, getPublished, isoDate } from '../../lib/content';

const ideas = await getPublished('ideas');
const rank = { high: 0, medium: 1, low: 2 } as const;
const sorted = ideas.sort(
  (a, b) => rank[a.data.priority] - rank[b.data.priority] || byDateDesc(a, b),
);
---

<BaseLayout
  title="Ideas"
  description="Short concepts and future Raspberry Pi experiments, ordered by priority."
>
  <div class="container page">
    <header class="page-header">
      <h1>Ideas</h1>
      <p class="lede">
        Concepts that are not yet projects. Some will become builds; some will quietly turn out to
        be a bad idea, which is also useful to know. Highest priority first.
      </p>
    </header>

    {sorted.length === 0 && <p class="empty">No ideas yet.</p>}

    <ul class="entry-list">
      {sorted.map((i) => (
        <EntryItem
          href={url(`/ideas/${i.id}/`)}
          title={i.data.title}
          description={i.data.description}
          tags={i.data.tags}
        >
          <Fragment slot="meta">
            <StatusBadge status={i.data.status} />
            <span>Priority: {i.data.priority}</span>
            <time datetime={isoDate(i.data.date)}>{formatDate(i.data.date)}</time>
            {i.data.draft && <span>Draft</span>}
          </Fragment>
        </EntryItem>
      ))}
    </ul>
  </div>
</BaseLayout>
