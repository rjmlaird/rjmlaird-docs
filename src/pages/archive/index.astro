---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('archive')).sort((a,b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Archive" description="Archive material for the RJM Laird ecosystem.">
  <section class="hero"><p class="eyebrow">Knowledge base</p><h1>Archive</h1><p class="muted">Retired systems and historical documentation.</p></section>
  {entries.length > 0 ? <ul>{entries.map(entry => <li><a href={`/archive/${entry.id.replace(/\.mdx?$/, '')}/`}>{entry.data.title}</a> <span class="meta">— {entry.data.description}</span></li>)}</ul> : <p class="empty">No archive pages have been published yet. Add Markdown files to <code>src/content/archive/</code>.</p>}
</BaseLayout>
