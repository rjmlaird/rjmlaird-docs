---
// src/pages/projects/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (
  await getCollection(
    "projects",
    ({ data }) => data.visibility === "public",
  )
).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "en-GB"),
);
---

<BaseLayout
  title="Projects"
  description="Index of sites, services, repositories and tools in the RJM Laird ecosystem."
>
  <section class="hero">
    <p class="eyebrow">Registry</p>

    <h1>Projects and services</h1>

    <p class="muted">
      A project index connecting documentation, source repositories and
      known live surfaces.
    </p>

    {
      projects.length > 0 && (
        <div data-project-filter hidden>
          <label for="project-search">Filter projects</label>

          <div class="toolbar">
            <input
              class="search"
              id="project-search"
              type="search"
              placeholder="Search projects, technologies or status"
              autocomplete="off"
              aria-controls="project-list"
              aria-describedby="project-count"
            />
          </div>
        </div>
      )
    }

    <p
      id="project-count"
      class="muted"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      {projects.length} public {projects.length === 1 ? "project" : "projects"}
    </p>
  </section>

  {
    projects.length > 0 ? (
      <>
        <div class="grid" id="project-list">
          {projects.map((p) => (
            <div
              data-project-card
              data-search={[
                p.data.title,
                p.data.description,
                p.data.status,
                ...p.data.tags,
                ...p.data.stack,
              ]
                .join(" ")
                .toLowerCase()}
            >
              <ProjectCard
                title={p.data.title}
                description={p.data.description}
                status={p.data.status}
                href={`/projects/${p.id}/`}
                repository={p.data.repository}
                liveUrl={p.data.liveUrl}
              />
            </div>
          ))}
        </div>

        <p id="project-empty" class="muted" hidden>
          No matching projects. Try another search term.
        </p>
      </>
    ) : (
      <p class="muted">No public projects to show yet.</p>
    )
  }
</BaseLayout>

<script>
  function initialiseProjectFilter() {
    const controls = document.querySelector<HTMLElement>(
      "[data-project-filter]",
    );

    const input = document.querySelector<HTMLInputElement>(
      "#project-search",
    );

    const list = document.querySelector<HTMLElement>("#project-list");
    const count = document.querySelector<HTMLElement>("#project-count");
    const empty = document.querySelector<HTMLElement>("#project-empty");

    if (
      !controls ||
      !input ||
      !list ||
      !count ||
      !empty ||
      input.dataset.initialised === "true"
    ) {
      return;
    }

    const cards = Array.from(
      list.querySelectorAll<HTMLElement>("[data-project-card]"),
    );

    const updateResults = () => {
      const query = input.value.trim().toLowerCase();
      let visibleCount = 0;

      for (const card of cards) {
        const matches = (card.dataset.search ?? "").includes(query);

        card.hidden = !matches;

        if (matches) visibleCount += 1;
      }

      const noun = cards.length === 1 ? "project" : "projects";

      count.textContent = query
        ? `${visibleCount} of ${cards.length} public ${noun}`
        : `${cards.length} public ${noun}`;

      empty.hidden = visibleCount !== 0;
    };

    input.addEventListener("input", updateResults);
    input.dataset.initialised = "true";

    controls.hidden = false;
    updateResults();
  }

  initialiseProjectFilter();

  document.addEventListener(
    "astro:page-load",
    initialiseProjectFilter,
  );
</script>

<style>
  [data-project-filter][hidden],
  #project-list > [hidden],
  #project-empty[hidden] {
    display: none;
  }

  #project-list > div {
    min-width: 0;
  }
</style>
