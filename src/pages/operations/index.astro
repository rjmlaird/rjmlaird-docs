---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('operations')).sort((a,b) => a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Operations" description="Operations material for the RJM Laird ecosystem.">
  <section class="hero"><p class="eyebrow">Knowledge base</p><h1>Operations</h1><p class="muted">Operational procedures and maintenance guidance.</p></section>
  {entries.length > 0 ? <ul>{entries.map(entry => <li><a href={`/operations/${entry.id.replace(/\.mdx?$/, '')}/`}>{entry.data.title}</a> <span class="meta">— {entry.data.description}</span></li>)}</ul> : <p class="empty">No operations pages have been published yet. Add Markdown files to <code>src/content/operations/</code>.</p>}
</BaseLayout>
