# Behind a TLS-terminating proxy; HSTS is still sent by the proxy or here.
{
	auto_https off
}
:8080 {
	root * /srv/dist
	import /etc/caddy/generated/security-headers.caddy
	import /etc/caddy/generated/redirects.caddy
	import security_headers
	import legacy_redirects
	encode zstd gzip
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
