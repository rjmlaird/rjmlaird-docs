{
  "name": "rjmlaird-docs",
  "version": "0.2.0",
  "private": true,
  "description": "Markdown-first documentation platform for the RJM Laird ecosystem",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint:content": "node scripts/validate-content.mjs",
    "lint:links": "node scripts/check-internal-links.mjs",
    "new:project": "node scripts/new-project.mjs",
    "test": "node --test",
    "validate": "pnpm run lint:content && pnpm run lint:links && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/sitemap": "3.6.0",
    "astro": "5.13.5",
    "typescript": "5.6.3",
    "zod": "3.25.0"
  },
  "devDependencies": {},
  "packageManager": "pnpm@10.34.6"
}
