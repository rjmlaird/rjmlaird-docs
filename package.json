{
  "name": "rjmlaird-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Public documentation for the rjmlaird.co.uk digital estate, built with Astro Starlight",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "generate": "node scripts/generate-catalogues.mjs",
    "dev": "node scripts/generate-catalogues.mjs && astro dev",
    "start": "pnpm dev",
    "build": "node scripts/generate-catalogues.mjs && astro build && node scripts/postbuild-headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint:content": "node scripts/validate-content.mjs",
    "lint:safety": "node scripts/public-safety-scan.mjs",
    "sync:builds": "node scripts/sync-builds.mjs",
    "sync:boards": "node scripts/sync-github-projects.mjs",
    "sync:repos": "node scripts/sync-github-repos.mjs",
    "sync": "pnpm sync:builds && pnpm sync:repos && pnpm sync:boards",
    "test": "node --test tests/*.test.mjs",
    "validate": "pnpm lint:content && pnpm check && pnpm build && pnpm lint:safety --dist"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^7.4.4",
    "astro-mermaid": "^2.2.0",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
