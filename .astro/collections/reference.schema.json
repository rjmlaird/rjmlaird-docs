{
  "$ref": "#/definitions/reference",
  "definitions": {
    "reference": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "status": {
          "type": "string",
          "default": "active"
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "reviewed",
            "needs-review"
          ],
          "default": "needs-review"
        },
        "owner": {
          "type": "string",
          "default": "Ryan Laird"
        },
        "lastReviewed": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}