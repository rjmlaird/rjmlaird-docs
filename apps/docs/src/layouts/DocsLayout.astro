---
import Head from "../components/Head.astro";
import "../styles/global.css";

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
    />
  </head>
  <body>
    <main class="page">
      <slot />
    </main>
  </body>
</html>
