{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subdomains.schema.json",
  "title": "rjmlaird.co.uk public service catalogue",
  "description": "Public, non-sensitive metadata for each service in the estate. Never add secrets, account or binding identifiers, internal hostnames, private URLs or access-policy detail.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "domain", "updated", "subdomains"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "domain": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "subdomains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "hostname", "title", "purpose", "classification", "visibility", "lifecycle", "evidence", "documentation", "publish"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Unique, lowercase, single label. Also the documentation file name." },
          "hostname": { "type": ["string", "null"], "pattern": "^[a-z0-9.-]+$", "description": "Fully qualified hostname, or null for a concept with no hostname." },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1, "description": "One public-safe sentence." },
          "classification": {
            "type": "string",
            "enum": ["website", "documentation", "api", "data", "asset-delivery", "asset-management", "ingestion", "identity", "protocol", "integration", "storage", "status", "catalogue", "developer", "experimental", "control-plane"]
          },
          "visibility": { "type": "string", "enum": ["public", "restricted", "internal"] },
          "lifecycle": { "type": "string", "enum": ["active", "planned", "reserved", "retired"] },
          "evidence": { "type": "string", "enum": ["repository", "owner-stated", "linked", "none"], "description": "How the lifecycle was established. Anything other than repository is unverified." },
          "documentation": { "type": ["string", "null"], "description": "Path of the service page relative to docs/, ending in .md, or null." },
          "publish": { "type": "boolean", "description": "Only records with true appear in the generated public table." },
          "status": { "type": ["string", "null"], "description": "Public status-page URL, or null." },
          "health": { "type": ["string", "null"], "description": "Public health URL only; null for restricted services." },
          "repository": { "type": ["string", "null"], "description": "Public repository URL, or null." }
        }
      }
    }
  }
}
